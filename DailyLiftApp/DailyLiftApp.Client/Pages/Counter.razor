@page "/settings"

<PageTitle>Settings - Daily Lift</PageTitle>

<div class="settings-container">
    <h1>Settings</h1>

    <!-- Theme Selection - Simplified for now -->
    <div class="section">
        <h3>Appearance</h3>
        <p><em>Theme options coming soon...</em></p>
    </div>

    <!-- Content Preferences -->
    <div class="section">
        <h3>Content Preferences</h3>
        @foreach (var category in Categories)
        {
            <div class="category-row">
                <label>
                    <input type="checkbox" @bind="category.Enabled" />
                    @category.Name
                </label>
                <div class="weight-slider">
                    <input type="range" min="1" max="10" @bind="category.Weight" />
                    <span>@category.Weight</span>
                </div>
            </div>
        }
    </div>

    <!-- Submission Form -->
    <div class="section">
        <h3>Submit New Content</h3>
        <input placeholder="Category Name (optional)" @bind="NewCategory" />
        <textarea placeholder="Write your quote, joke, or message here..." @bind="NewContent" rows="4"></textarea>
        <input placeholder="Submit as (username)" @bind="SubmitterName" />
        <button @onclick="SubmitContent">Submit Suggestion</button>
    </div>
</div>

@code {
    private List<CategoryPreference> Categories = new();

    private string NewCategory = "";
    private string NewContent = "";
    private string SubmitterName = "";

    protected override void OnInitialized()
    {
        Categories = new List<CategoryPreference>
        {
            new CategoryPreference { Name = "Motivational", Enabled = true, Weight = 8 },
            new CategoryPreference { Name = "Dad Jokes", Enabled = true, Weight = 5 },
            new CategoryPreference { Name = "Life Advice", Enabled = true, Weight = 7 },
            new CategoryPreference { Name = "Fitness", Enabled = true, Weight = 6 }
        };
    }

    private async Task SubmitContent()
    {
        if (!string.IsNullOrWhiteSpace(NewContent))
        {
            Console.WriteLine($"New submission: {NewContent} by {SubmitterName}");
            // TODO: Send email here

            NewContent = "";
            NewCategory = "";
            SubmitterName = "";
        }
    }

    public class CategoryPreference
    {
        public string Name { get; set; } = "";
        public bool Enabled { get; set; } = true;
        public int Weight { get; set; } = 5;
    }
}