@page "/settings"

@using DailyLiftApp.Client.Models
@using DailyLiftApp.Client.Services

@inject LiftService LiftService

@inject IJSRuntime JSRuntime

<PageTitle>Settings - Daily Lift</PageTitle>

<div class="settings-container">
    <h1>Settings</h1>

    <!-- Theme -->
    <div class="section">
        <h3>Appearance</h3>
        <p><em>Theme options coming soon...</em></p>
    </div>

    <!-- Content Preferences -->
    <div class="section">
        <h3>Content Preferences</h3>
        @foreach (var category in AllCategories)
        {
            <div class="category-row">
                <label>
                    <input type="checkbox" 
                           checked="@selectedCategories.Contains(category)" 
                           @onchange="@((ChangeEventArgs e) => ToggleCategory(category, e.Value))" />
                    @category
                </label>
                
                <div class="weight-slider">
                    <input type="range" min="1" max="10" value="5" disabled />
                    <span>5</span>
                </div>
            </div>
        }
    </div>

    <!-- Submission -->
    <div class="section">
        <h3>Submit New Content</h3>
        <input placeholder="Category Name (optional)" @bind="NewCategory" />
        <textarea placeholder="Write your quote, joke, or message here..." @bind="NewContent" rows="4"></textarea>
        <input placeholder="Submit as (username)" @bind="SubmitterName" />
        <button @onclick="SubmitContent">Submit Suggestion</button>
    </div>
</div>

@code {
    private List<string> AllCategories = new();
    private List<string> selectedCategories = new();

    private string NewCategory = "";
    private string NewContent = "";
    private string SubmitterName = "";

    protected override async Task OnInitializedAsync()
    {
        var allLifts = await LiftService.GetLiftsAsync();
        
        AllCategories = allLifts
            .Select(l => l.Category)
            .Distinct()
            .OrderBy(c => c)
            .ToList();

        selectedCategories = AllCategories.ToList(); // start with all selected
    }

    private void ToggleCategory(string category, object? value)
    {
        bool isChecked = value?.ToString() == "true";

        if (isChecked)
        {
            if (!selectedCategories.Contains(category))
                selectedCategories.Add(category);
        }
        else
        {
            selectedCategories.Remove(category);
        }
    }

    private async Task SubmitContent()
    {
        if (!string.IsNullOrWhiteSpace(NewContent))
        {
            Console.WriteLine($"Submitted: {NewContent} by {SubmitterName}");
            // TODO: Send email

            NewContent = "";
            NewCategory = "";
            SubmitterName = "";
        }
    }
}