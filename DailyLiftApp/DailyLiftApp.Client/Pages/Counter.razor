@page "/settings"

@using DailyLiftApp.Client.Models
@using DailyLiftApp.Client.Services

@inject LiftService LiftService
@inject IJSRuntime JSRuntime

<PageTitle>Settings - Daily Lift</PageTitle>

<<style>

    body.dark-theme {
        background-color: #121212 !important;
        color: white !important;
    }

    body.dark-theme .settings-container,
    body.dark-theme .section {
        background-color: #1e1e1e !important;
        color: white !important;
    }

    body.dark-theme input,
    body.dark-theme textarea,
    body.dark-theme select {
        background-color: #2a2a2a !important;
        color: white !important;
        border: 1px solid #555 !important;
    }

    body.dark-theme input::placeholder,
    body.dark-theme textarea::placeholder {
        color: #bbbbbb !important;
    }

    body.dark-theme h1,
    body.dark-theme h2,
    body.dark-theme h3,
    body.dark-theme h4,
    body.dark-theme h5,
    body.dark-theme h6,
    body.dark-theme label,
    body.dark-theme span,
    body.dark-theme div,
    body.dark-theme p,
    body.dark-theme button {
        color: white !important;
    }

</style>
<div class="settings-container">
    <h1>Settings</h1>

    <!-- Theme Selection -->
    <div class="section">
        <h3>Appearance</h3>

        <div class="theme-options">

            <label>
                <input type="radio"
                       name="theme"
                       value="light"
                       checked="@(CurrentTheme == "light")"
                       @onchange='@(() => SetTheme("light"))' />
                Light
            </label>

            <label>
                <input type="radio"
                       name="theme"
                       value="dark"
                       checked="@(CurrentTheme == "dark")"
                       @onchange='@(() => SetTheme("dark"))' />
                Dark
            </label>

            <label>
                <input type="radio"
                       name="theme"
                       value="system"
                       checked="@(CurrentTheme == "system")"
                       @onchange='@(() => SetTheme("system"))' />
                System
            </label>

        </div>
    </div>

    <!-- Content Preferences -->
    <div class="section">
        <h3>Content Preferences</h3>

        @foreach (var category in AllCategories)
        {
            <div class="category-row">

                <label>
                    <input type="checkbox"
                           checked="@selectedCategories.Contains(category)"
                           @onchange="@(e => ToggleCategory(category, e.Value))" />
                    @category
                </label>

                <div class="weight-slider">

                    <input type="range"
                           min="1"
                           max="10"
                           value="@GetWeight(category)"
                           @onchange="@(e => SetWeight(category, e.Value))" />

                    <span>@GetWeight(category)</span>

                </div>

            </div>
        }
    </div>

    <!-- Submission -->
    <div class="section">
        <h3>Submit New Content</h3>

        <input placeholder="Category Name (optional)"
               @bind="NewCategory" />

        <textarea placeholder="Write your quote, joke, or message here..."
                  @bind="NewContent"
                  rows="4"></textarea>

        <input placeholder="Submit as (username)"
               @bind="SubmitterName" />

        <button @onclick="SubmitContent">
            Submit Suggestion
        </button>
    </div>
</div>

@code {

    private string CurrentTheme = "system";

    private List<string> AllCategories = new();
    private List<string> selectedCategories = new();
    private Dictionary<string, int> categoryWeights = new();

    private string NewCategory = "";
    private string NewContent = "";
    private string SubmitterName = "";

    protected override async Task OnInitializedAsync()
    {
        var allLifts = await LiftService.GetLiftsAsync();

        AllCategories = allLifts
            .Select(l => l.Category)
            .Distinct()
            .OrderBy(c => c)
            .ToList();

        selectedCategories = AllCategories.ToList();

        foreach (var cat in AllCategories)
        {
            categoryWeights[cat] = 5;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
{
    if (firstRender)
    {
        CurrentTheme = await JSRuntime.InvokeAsync<string>(
            "themeManager.loadTheme"
        );

        StateHasChanged();
    }
}

    private int GetWeight(string category)
    {
        return categoryWeights.TryGetValue(category, out var weight)
            ? weight
            : 5;
    }

    private void SetWeight(string category, object? value)
    {
        if (int.TryParse(value?.ToString(), out var weight))
        {
            categoryWeights[category] = weight;
        }
    }

    private void ToggleCategory(string category, object? value)
    {
        bool isChecked = value?.ToString() == "true";

        if (isChecked)
        {
            if (!selectedCategories.Contains(category))
            {
                selectedCategories.Add(category);
            }
        }
        else
        {
            selectedCategories.Remove(category);
        }
    }

    private async Task SetTheme(string theme)
{
    CurrentTheme = theme;

    await JSRuntime.InvokeVoidAsync(
        "themeManager.setTheme",
        theme
    );

    StateHasChanged();
}

    private async Task SubmitContent()
    {
        if (!string.IsNullOrWhiteSpace(NewContent))
        {
            Console.WriteLine($"Submitted: {NewContent} by {SubmitterName}");

            // TODO: Send email or save to database

            NewContent = "";
            NewCategory = "";
            SubmitterName = "";
        }
    }
}